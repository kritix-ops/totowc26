{
  "name": "toto-mundial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/maybe-migrate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "push:vapid": "node scripts/generate-vapid.mjs",
    "e2e:reminder": "node --env-file=.env.local scripts/e2e-reminder.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:bootstrap-admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "logo:strip": "node scripts/strip-logo-bg.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "splashes:build": "node scripts/build-splashes.mjs",
    "db:score": "node --env-file=.env.local scripts/score-matches.mjs",
    "db:clean-mock": "node --env-file=.env.local scripts/clean-mock-matches.mjs",
    "api:fixtures": "node --env-file=.env.local scripts/api-sync-fixtures.mjs",
    "api:sync": "node --env-file=.env.local scripts/api-sync-fixtures.mjs && node --env-file=.env.local scripts/score-matches.mjs",
    "api-football:map": "node --env-file=.env.local scripts/api-football-map-fixtures.mjs",
    "api-football:verify-teams": "node --env-file=.env.local scripts/api-football-verify-teams.mjs",
    "api-football:check": "node --env-file=.env.local scripts/api-football-check-mapping.mjs",
    "api-football:probe": "node --env-file=.env.local scripts/api-football-probe.mjs",
    "api-football:squads": "node --env-file=.env.local scripts/api-football-sync-squads.mjs",
    "translate:players": "node --env-file=.env.local scripts/translate-players.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.3.3",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "web-push": "^3.6.7"
  }
}
